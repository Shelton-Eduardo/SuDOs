{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build with G++ by Shedu",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++20",
                "-Iinclude",
                "/nologo",
                "/Fe${workspaceFolder}\\Executables\\${fileBasenameNoExtension}.exe",
                "/Fo${workspaceFolder}\\Executables\\",
                "/Fd${workspaceFolder}\\Executables\\",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.",
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "clear": true,
                "close": true
            }
        },
        {
            "type": "cppbuild",
            "label": "Built with G++ by Shedu",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-Iinclude",
                "${workspaceFolder}\\*.cpp",
                "-o",
                "${workspaceFolder}\\Executables\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: C:\\msys64\\ucrt64\\bin\\g++.exe",
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "clear": true,
                "close": true
            }
        }
    ],
    "version": "2.0.0"
}
