{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build: Release (-O2)",
            "command": "/usr/bin/g++",
            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
                "args": [
                    "-std=c++20",
                    "-O2",
                    "-DNDEBUG",
                    "-s",
                    "-fdiagnostics-color=always",
                    "${workspaceFolder}\\src\\*.cpp",
                    "-I${workspaceFolder}\\include",
                    "-o",
                    "${workspaceFolder}\\Executables\\main.exe"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "linux": {
                "command": "/usr/bin/g++",
                "args": [
                    "-std=c++20",
                    "-O2",
                    "-DNDEBUG",
                    "-s",
                    "-fdiagnostics-color=always",
                    "${workspaceFolder}/src/*.cpp",
                    "-I${workspaceFolder}/include",
                    "-o",
                    "${workspaceFolder}/Executables/main"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Default Release build (-O2, no debugging overhead) for Windows & Linux"
        },
        {
            "type": "shell",
            "label": "Build: Debug (-g)",
            "command": "/usr/bin/g++",
            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
                "args": [
                    "-std=c++20",
                    "-g",
                    "-O0",
                    "-fdiagnostics-color=always",
                    "${workspaceFolder}\\src\\*.cpp",
                    "-I${workspaceFolder}\\include",
                    "-o",
                    "${workspaceFolder}\\Executables\\main_debug.exe"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "linux": {
                "command": "/usr/bin/g++",
                "args": [
                    "-std=c++20",
                    "-g",
                    "-O0",
                    "-fdiagnostics-color=always",
                    "${workspaceFolder}/src/*.cpp",
                    "-I${workspaceFolder}/include",
                    "-o",
                    "${workspaceFolder}/Executables/main_debug"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Debug build (-g -O0) triggered automatically by the debugger"
        }
    ]
}
